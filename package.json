{
  "name": "cf-text-relay",
  "version": "1.0.0",
  "description": "CF-TextRelay: Lightweight, fast & beautiful personal cross-device text relay on Cloudflare Workers + D1",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.js --bundle --format=esm --outfile=dist/worker.js",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute info-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute info-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "esbuild": "^0.17.19",
    "wrangler": "^3.114.0"
  }
}
